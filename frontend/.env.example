# -----------------------------------------------------------------------------
# DuHa frontend environment (Vite)
# Copy to `.env` for local dev. On Vercel, set these as Project -> Settings ->
# Environment Variables. Only VITE_* values are exposed to the browser, so never
# put secrets (OpenAI key, Supabase service_role key) here. Those live in
# Supabase Edge Function secrets instead (see docs/DEPLOYMENT.md).
# -----------------------------------------------------------------------------

# Supabase project URL, e.g. https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_URL=your_supabase_url

# Supabase anon public key (safe to expose; Row Level Security protects the data)
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
